//In this script I extract monthly MODIS EVI 2000-2021 (1 km scale)
//and find the annual mean 
//10th Oct 2024

//1. Data input
var modis_evi = ee.ImageCollection('MODIS/061/MOD13A3')
                  .filter(ee.Filter.date('2000-01-01', '2022-01-01'))
                  .select('EVI');
//print (modis_evi.size()); //263
//print (modis_evi);
var eviVis = {
  min: 0,
  max: 9000,
  palette: [
    'ffffff', 'ce7e45', 'df923d', 'f1b555', 'fcd163', '99b718', '74a901',
    '66a000', '529400', '3e8601', '207401', '056201', '004c00', '023b01',
    '012e01', '011d01', '011301'
  ],
};
//Map.setCenter(6.746, 46.529, 2);
//Map.addLayer(modis_evi, eviVis, 'EVI');

//2. Crop to Cerrado only
var buffer = ee.FeatureCollection("projects/ee-trishagopalakrishna/assets/Buffer_Cerrado_Climate_Zones");
var cerrado_evi= modis_evi.map(function(image) { 
  return image.clip(buffer).toFloat()
});

print (cerrado_evi);
Map.addLayer(cerrado_evi.first(),{}, "2000 Feb Cerrado EVI") 
print (cerrado_evi.size());//263 images ie for each month Feb (2nd month) 2000 to Dec 2021

//3. Creating multiband image to export
var img_modisevi_cerrado= cerrado_evi.toBands()
print(img_modisevi_cerrado);

var projection =  img_modisevi_cerrado.select("2001_02_01_EVI").projection()  
print (projection.crs());//weird SR-ORG: 6974 
print (projection.nominalScale()); //926.62 m

//export collection to google drive
Export.image.toDrive({
  image: img_modisevi_cerrado, 
  description: "Cerrado_monthly_EVI",
  folder:'GEE things', 
  scale: projection.nominalScale().getInfo(),
  crs: projection.crs().getInfo(),
  region: buffer});
  