//Data Input
var climatezones = ee.FeatureCollection("projects/ee-trishagopalakrishna/assets/Buffer_Cerrado_Climate_Zones");
//Map.addLayer (climatezones, {}, "Buffer Climate Zones");

 
print (anisoevi);
