//Note there is a scale factor of 10000. Hence values range from -2000 to 4000

//Mask ani evi image collection to cliamte zones and caatinga
var cerrado_anisoevi= anisoevi.map(function(image) { 
  return image.clip(climatezones).toFloat()
});

Map.addLayer(cerrado_anisoevi.first(), {min:-2000, max:4000, palette:['orange', 'black','green'], bands:["b1"]}, "2000 May Cerrado EVI_ANI") 
//For some reason FilterBounds does not apparently work for global composites eventhough it is meant to be for image collections like this one
print (cerrado_anisoevi.size());//262 images ie for each month May (5th month) 2000 to Dec 2021

