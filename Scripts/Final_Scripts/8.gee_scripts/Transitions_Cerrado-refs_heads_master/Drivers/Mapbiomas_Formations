var grass_other_waternotobserved_mask = grass_other_mask.mask(lulc_nowater_notobserved);
Map.addLayer (grass_other_waternotobserved_mask, Viz1, "Grass no water")

// //4. Aggregate to 5km such that pixel value= % pixels with value 1 to the total
var projection =  grass_other_waternotobserved_mask.projection(); //change formation accordingly
print (projection);
print (projection.crs());//EPSG 4326

var agg_product= grass_other_waternotobserved_mask//1-formation, 0-other and NA-water & not observed
   .reduceResolution({
     reducer: ee.Reducer.mean(),
     maxPixels: 35*35
     })
     .reproject({
       crs: projection.crs().getInfo(),
       scale:250 //first exporting at 250 m and then final export will be at 5000m
     });
print (agg_product);
var Viz2 = {bands: ['classification_2002'], min: 0, max: 1, palette: ['blue','green', 'red']};
Map.addLayer (agg_product, Viz2, "Aggregate formation");

