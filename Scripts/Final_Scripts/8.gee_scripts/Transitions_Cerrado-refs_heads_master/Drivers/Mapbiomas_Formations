//3. Exclude water and not observed from the reclassified anthropic multiband image

var forest_other_waternotobserved_mask = forest_other_mask.mask(lulc_nowater_notobserved);
Map.addLayer (forest_other_waternotobserved_mask, Viz1, "Forest no water");

