var MODIS_burnarea = ee.ImageCollection("MODIS/061/MCD64A1"),
    buffer_cerrado = ee.FeatureCollection("projects/ee-trishagopalakrishna/assets/Buffer_Cerrado_Climate_Zones");
/***** End of imports. If edited, may not auto-convert in the playground. *****/
//In this script, I process the latest version of MODIS fire frequency (500m) for the cerrado
// to calculate burned area
