//print('Timestamp- Start date : ', date_first); // Feb 1950

////////////////////////////////////2. Processing
var temp = era5_daily.select(['temperature_2m']);
var temp_timeperiod= temp.filterDate('1981', '2021');
//print (temp_timeperiod.limit(10)); 
//Map.addLayer (temp_timeperiod.first());
//var temp_timeperiod=ee.ImageCollection.fromImages(temp_timeperiod);
//print (temp_timeperiod.limit(5));

//// Calculation of long-term climatology for each month
//1. Group all days of Jan, all days of Feb..... Group all days of Dec
//2. Reduce using 90th percentile 

var annualpercentile = ee.List.sequence(1,12) .map(function(n){
    
    var month_temp = temp_timeperiod.filter(ee.Filter.calendarRange(n,n,'month'))
    
    return month_temp
          .reduce(ee.Reducer.percentile([90]))
          .set('month', n)
          
  });
        
//print (annualpercentile); //list
var imgcollection_annualpercentile = ee.ImageCollection.fromImages(annualpercentile);
//print (imgcollection_annualpercentile);
//Map.addLayer(imgcollection_annualpercentile.first());

//// Calculation considering 7 consecutive days rolling windows 
//1. For each day, test whether T is > var annualpercentile for January
//2. Create rolling window of 7 days before to 7 days after for each image
//   and sum rolling window images and take >= 5
//3. Create binary image collection (1 is heatwave) by multiplying two lists
//4. Calculate #heatwaves annually

var studyPeriodTemp = era5_daily.filterDate("2002", "2022").select(['temperature_2m']);

// Step 1
var studyPeriodHot = studyPeriodTemp.map(function(img) {
  
  var month = img.date().get("month");
  
  var monthPercentile = imgcollection_annualpercentile.filter(ee.Filter.eq("month", month)).first();
  
  var imgHot = img.gte(monthPercentile);
  
  return imgHot.copyProperties(img,['system:time_start']);
});

//print ("studyPeriodHot",studyPeriodHot.limit(10));
//print (studyPeriodHot.size()); //7305
//Map.addLayer(studyPeriodHot.first());

// Step 2
var studyPeriodWindow = studyPeriodHot.map(function(img) {
  
  var date = img.date();
  var start = date.advance(-7, "days");
  var end = date.advance(7, "days");
  
  var windowImgs = studyPeriodHot.filterDate(start, end);
  
  var windowHot = windowImgs.sum().gte(5); //5 consecutive days
  
  return windowHot.copyProperties(img,['system:time_start']);
  
});

//print("studyPeriodWindow", studyPeriodWindow.limit(10))
//print (studyPeriodWindow.size()); //7305

// Step 3
var band_index1 = ee.List.sequence(0, 7303); //timestamp t1 
//print (band_index1);
var band_index2 = ee.List.sequence(1, 7304); //timestamp t2 

var liststudyPeriodWindow = studyPeriodWindow.toList(studyPeriodWindow.size());

function getImages(list){
  var img = ee.Image(liststudyPeriodWindow.get(list));
  return img;
} 

var list_time1 = (band_index1.map(getImages));
var list_time2 = (band_index2.map(getImages));

var imgCollection_code = ee.ImageCollection(ee.List.sequence(0, 7303).map(function(n){ 
    
    var img1 = ee.Image(list_time1.get(n))
    
    var img2 = ee.Image(list_time2.get(n))
    
    var code_img = img1.multiply(10).add(img2);
    
    return code_img.copyProperties(img1,['system:time_start']);
}));
print (imgCollection_code.limit(10));

// Output will have each band with values 0, 1, 11, 10
// We want to count the number of times a pixel value is 1 through the timeseries
var heatwave_only= ee.ImageCollection(imgCollection_code.map(function(img){
    return img.eq(1).copyProperties(img,['system:time_start'])
}));
var heatwave_number= heatwave_only.sum() //#heatwaves across time period 2002-2022
//print (heatwave_number);
//Map.addLayer(heatwave_number);
